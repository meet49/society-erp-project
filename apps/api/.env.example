# ---- Runtime
NODE_ENV=development
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=false

# ---- Public URLs
APP_URL=http://localhost:5174
API_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ---- Database (leave MONGODB_URI empty in development to auto-start an embedded MongoDB replica set)
MONGODB_URI=
MONGODB_DB_NAME=society_erp
EMBEDDED_MONGO_PATH=.data/mongo

# ---- Redis (optional in development; required in production for BullMQ + multi-instance cache invalidation)
REDIS_URL=

# ---- Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
SIGNED_URL_SECRET=change-me-signed-url-secret
ENCRYPTION_KEY=change-me-encryption-key-must-be-32-chars-min
BCRYPT_ROUNDS=11
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# ---- Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=15

# ---- Email (console | smtp | brevo)
#
# Sending from a PaaS host: Render free instances block outbound ports 25, 465 and 587 (port 25 is
# blocked on every plan). Gmail only listens on 465 and 587, so Gmail SMTP cannot work there at all.
# Two ways out, both free:
#   1. SMTP on port 2525, which Render does not block. Brevo's relay accepts it:
#        SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=2525  SMTP_SECURE=false
#        SMTP_USER=<your Brevo SMTP login>  SMTP_PASS=<your Brevo SMTP key, not the API key>
#   2. EMAIL_DRIVER=brevo with BREVO_API_KEY, which goes over HTTPS on 443.
# Paid Render instances allow 465 and 587, so Gmail SMTP works once you upgrade.
BREVO_API_KEY=
EMAIL_DRIVER=console
EMAIL_FROM="Society ERP <no-reply@societyerp.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- WhatsApp (console | meta)
WHATSAPP_DRIVER=console
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=

# ---- Web push (console | webpush)
PUSH_DRIVER=console
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@societyerp.local

# ---- Payments for platform subscriptions (mock | razorpay)
PAYMENT_DRIVER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=mock-payment-secret

# ---- Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# ---- Seed
SEED_SUPER_ADMIN_EMAIL=superadmin@societyerp.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_DEMO_DATA=true
